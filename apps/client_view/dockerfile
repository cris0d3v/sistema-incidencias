# syntax=docker/dockerfile:1

FROM node:24-alpine AS base
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app

# ---- deps: install workspace dependencies in frozen mode ----
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/client_view/package.json apps/client_view/
RUN pnpm install --frozen-lockfile --filter client_view...

# ---- build: generate the static bundle with Vite ----
FROM deps AS build
COPY apps/client_view apps/client_view
RUN pnpm --filter client_view generate-routes && pnpm --filter client_view build

# ---- runner: nginx serves the static files ----
FROM nginx:1.27-alpine AS runner
COPY apps/client_view/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/client_view/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
